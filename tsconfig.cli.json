{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "paths": {
      "@felyx-fu/diffsentry-config": ["packages/config/src/index.ts"],
      "@felyx-fu/diffsentry-contracts": ["packages/contracts/src/index.ts"],
      "@felyx-fu/diffsentry-core": ["packages/core/src/index.ts"],
      "@felyx-fu/diffsentry-report": ["packages/report/src/index.ts"],
      "@felyx-fu/diffsentry-rules": ["packages/rules/src/index.ts"],
      "@felyx-fu/diffsentry-runtime-node": [
        "packages/runtime-node/src/index.ts"
      ]
    },
    "types": ["node", "vitest"]
  },
  "include": [
    "packages/cli/src/**/*.ts",
    "packages/config/src/**/*.ts",
    "packages/contracts/src/**/*.ts",
    "packages/core/src/**/*.ts",
    "packages/report/src/**/*.ts",
    "packages/rules/src/**/*.ts",
    "packages/runtime-node/src/**/*.ts",
    "tests/e2e/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
